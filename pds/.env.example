# Self-hosted atproto PDS config. Copy to .env and fill in.
# See: https://github.com/bluesky-social/pds

PDS_HOSTNAME=pds.example.org
PDS_JWT_SECRET=changeme-generate-with-openssl-rand-hex-16
PDS_ADMIN_PASSWORD=changeme
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=changeme-generate-with-openssl-ecparam
PDS_DATA_DIRECTORY=/pds
PDS_BLOBSTORE_DISK_LOCATION=/pds/blocks
PDS_DID_PLC_URL=https://plc.directory
PDS_BSKY_APP_VIEW_URL=
PDS_BSKY_APP_VIEW_DID=
PDS_CRAWLERS=
PDS_EMAIL_FROM_ADDRESS=
PDS_EMAIL_SMTP_URL=
