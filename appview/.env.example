PDS_URL=http://localhost:3000
EVENT_COLLECTION=org.micelio.event
RSVP_COLLECTION=org.micelio.rsvp
COUNTER_DB_PATH=./counter.sqlite
PORT=8080
APPVIEW_ADMIN_TOKEN=changeme

# Firehose indexer (see docs/firehose-indexer-spec.md, "npm run indexer" to
# start the consumer). Off by default — pds.js falls back to live repo
# fanout until this is true and the indexer has backfilled.
INDEXER_ENABLED=false

# Comma-separated exact origins allowed to call this API. Defaults to the
# local dev frontend if unset — set to your real frontend origin(s) before
# deploying anywhere reachable off localhost.
APPVIEW_ALLOWED_ORIGINS=https://yourapp.com
