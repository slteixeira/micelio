PUBLIC_APPVIEW_URL=http://localhost:8080
PUBLIC_PDS_URL=http://localhost:2583

# Leave empty for local dev — uses a loopback OAuth client (no hosted
# metadata needed, only works from http://127.0.0.1:<port>, NOT
# "localhost" — open the app at 127.0.0.1 during dev). Once deployed, set
# to "https://yourapp.com/client-metadata.json" — the app serves that
# route itself (src/routes/client-metadata.json/+server.js), no separate
# file to author or keep in sync.
PUBLIC_OAUTH_CLIENT_ID=

# Dev-env's local PLC directory (npm run dev:pds pins this port). Leave
# empty in production — defaults to the real https://plc.directory.
PUBLIC_PLC_URL=http://localhost:2582
